{
  "installCommand": "npm install",
  "buildCommand": "cd frontend && npm install --legacy-peer-deps && npx expo export -p web",
  "outputDirectory": "frontend/dist",
  "framework": null,
  "rewrites": [
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ],
  "crons": [
    { "path": "/api/cron/positions", "schedule": "*/5 * * * *" }
  ]
}
