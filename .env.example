# ── Frontend ──────────────────────────────────────────────────────────────────
EXPO_PUBLIC_API_URL=https://api.your-domain.com

# ── Railway PostgreSQL (계좌 영구 저장 — 기기 간 동기화) ────────────────────────
# Railway 프로젝트 > Variables 탭에서 DATABASE_URL 복사 후 Vercel 환경변수에 추가
# Railway > Query 탭에서 아래 SQL 한 번 실행:
#
#   CREATE TABLE IF NOT EXISTS exchange_accounts (
#     user_id    TEXT PRIMARY KEY,
#     data       TEXT NOT NULL,
#     updated_at TIMESTAMPTZ DEFAULT now()
#   );
#
DATABASE_URL=postgresql://user:password@host.railway.app:5432/railway

# API 키 암호화용 비밀 문자열 (32자 이상 임의 문자열, 절대 공개 금지)
ACCOUNTS_ENCRYPTION_KEY=change-me-to-a-long-random-string-32chars+
