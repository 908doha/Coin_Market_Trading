# Gate.io API Configuration
GATEIO_API_KEY=your_api_key_here
GATEIO_API_SECRET=your_api_secret_here

# Trading Configuration
TRADE_PAIR=BTC_USDT
LEVERAGE=5
POSITION_SIZE_USDT=100
MAX_POSITIONS=3

# Risk Management
STOP_LOSS_PERCENT=2
TAKE_PROFIT_PERCENT=4
MAX_DAILY_LOSS_USDT=300

# Multi-Timeframe (HTF → MTF → LTF)
HTF_INTERVAL=4h
MTF_INTERVAL=1h
LTF_INTERVAL=15m

# Bot Configuration
BOT_CRON_SCHEDULE=*/1 * * * *
LOG_LEVEL=info
