# Gate.io API Configuration
GATEIO_API_KEY=your_api_key_here
GATEIO_API_SECRET=your_api_secret_here

# Trading Configuration
# 복수 페어 지원: TRADE_PAIRS 에 콤마 구분으로 나열
TRADE_PAIRS=BTC_USDT,ETH_USDT,XAG_USDT,XAUT_USDT,XBR_USDT,XTI_USDT
LEVERAGE=5
MAX_POSITIONS=3

# Risk Management
STOP_LOSS_PERCENT=2
TAKE_PROFIT_PERCENT=4
MAX_DAILY_LOSS_USDT=300

# Kelly Criterion (페어별 독립 통계, 항상 적용)
KELLY_FRACTION=0.5
KELLY_MAX_FRACTION=0.25
KELLY_MIN_TRADES=20
KELLY_DEFAULT_FRACTION=0.02
# 전 페어 합산 leveraged notional 상한 (잔고 대비)
KELLY_MAX_TOTAL_EXPOSURE=0.5

# Telegram Notification
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here

# Multi-Timeframe (HTF → MTF → LTF)
HTF_INTERVAL=4h
MTF_INTERVAL=15m
LTF_INTERVAL=5m

# Bot Configuration
BOT_CRON_SCHEDULE=*/1 * * * *
LOG_LEVEL=info
