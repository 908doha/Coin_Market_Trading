{
  "name": "osprey-backend",
  "version": "1.0.0",
  "description": "Osprey API Server + Gate.io Trading Bot",
  "main": "src/server.js",
  "scripts": {
    "start":        "node src/server.js",
    "start:bot":    "node src/bot.js",
    "start:all":    "concurrently \"npm run start\" \"npm run start:bot\"",
    "dev":          "node --watch src/server.js",
    "dev:bot":      "node --watch src/bot.js",
    "pm2:start":    "pm2 start ecosystem.config.js",
    "pm2:stop":     "pm2 stop all",
    "pm2:restart":  "pm2 restart all",
    "pm2:logs":     "pm2 logs",
    "pm2:status":   "pm2 status"
  },
  "license": "MIT",
  "dependencies": {
    "bcryptjs":              "^2.4.3",
    "better-sqlite3":        "^9.4.3",
    "concurrently":          "^8.2.2",
    "cors":                  "^2.8.5",
    "dotenv":                "^16.3.1",
    "express":               "^4.18.2",
    "gate-api":              "^6.63.0",
    "jsonwebtoken":          "^9.0.2",
    "node-cron":             "^3.0.3",
    "node-telegram-bot-api": "^0.67.0",
    "uuid":                  "^9.0.0",
    "winston":               "^3.11.0"
  }
}
