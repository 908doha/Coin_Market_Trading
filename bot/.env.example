# Gate.io API Configuration
# ── 싱글 계좌 (하위호환) ──
# GATEIO_ACCOUNTS 가 없으면 아래 단일 키를 'default' 계좌로 사용
GATEIO_API_KEY=your_api_key_here
GATEIO_API_SECRET=your_api_secret_here

# ── 복수 계좌 (선택) ──
# GATEIO_ACCOUNTS 설정 시 위의 GATEIO_API_KEY/SECRET 무시
# 계좌 ID 는 영문소문자+숫자 권장 (로그/텔레그램 표기용)
# GATEIO_ACCOUNTS=main,sub,third
# GATEIO_API_KEY_MAIN=...
# GATEIO_API_SECRET_MAIN=...
# GATEIO_API_KEY_SUB=...
# GATEIO_API_SECRET_SUB=...
# GATEIO_API_KEY_THIRD=...
# GATEIO_API_SECRET_THIRD=...

# Trading Configuration
# 복수 페어 지원: TRADE_PAIRS 에 콤마 구분으로 나열
TRADE_PAIRS=BTC_USDT,ETH_USDT,XAG_USDT,XAUT_USDT,XBR_USDT,XTI_USDT
LEVERAGE=5
MAX_POSITIONS=3

# Risk Management
STOP_LOSS_PERCENT=2
TAKE_PROFIT_PERCENT=4
MAX_DAILY_LOSS_USDT=300

# Kelly Criterion (페어별 독립 통계, 항상 적용)
KELLY_FRACTION=0.5
KELLY_MAX_FRACTION=0.15
KELLY_MIN_TRADES=20
KELLY_DEFAULT_FRACTION=0.03
# 전 페어 합산 leveraged notional 상한 (잔고 대비)
KELLY_MAX_TOTAL_EXPOSURE=0.6

# Telegram Notification
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here

# Multi-Timeframe (HTF → MTF → LTF)
HTF_INTERVAL=4h
MTF_INTERVAL=15m
LTF_INTERVAL=5m

# Bot Configuration
BOT_CRON_SCHEDULE=*/1 * * * *
LOG_LEVEL=info
