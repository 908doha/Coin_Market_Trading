{
  "buildCommand": "npx expo export -p web",
  "outputDirectory": "dist",
  "framework": null,
  "rewrites": [
    { "source": "/api/bot/:path*", "destination": "/api/bot/[...path]" },
    { "source": "/api/(.*)",       "destination": "/api/$1" },
    { "source": "/:path*",         "destination": "/index.html" }
  ]
}
